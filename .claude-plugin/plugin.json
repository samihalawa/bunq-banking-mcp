{
  "name": "bunq-banking-mcp",
  "version": "0.3.3",
  "description": "bunq banking MCP and evidence-based subscription and finance workflows.",
  "author": {
    "name": "Sami Halawa",
    "url": "https://github.com/samihalawa",
    "email": "sami@samihalawa.com"
  },
  "repository": "https://github.com/samihalawa/bunq-banking-mcp",
  "license": "MIT",
  "keywords": [
    "bunq",
    "banking",
    "subscriptions",
    "reconciliation",
    "finance"
  ],
  "mcpServers": {
    "bunq-banking": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--isolated",
        "--no-env-file",
        "--python",
        "3.11",
        "--with-requirements",
        "${CLAUDE_PLUGIN_ROOT}/requirements.txt",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/plugin_launcher.py"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
